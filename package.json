    "three": "0.187.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.16.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
