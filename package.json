{
  "name": "ctrl-alt-defend-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "balance": "tsx tools/balance.ts",
    "mp": "MP_PORT=8098 ALLOWED_ORIGINS= tsx server/mp/main.ts",
    "build:mp": "esbuild server/mp/main.ts --bundle --platform=node --format=cjs --target=node24 --external:bufferutil --external:utf-8-validate --outfile=dist-server/mp.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
